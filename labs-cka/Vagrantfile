Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.boot_timeout = 600

  nodes = {
    "k8s-cp" => { nid: 1, memory: 3072, cpus: 2 },
    "k8s-worker" => { nid: 2, memory: 2048, cpus: 2 }
  }

  nodes.each do |name, settings|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "public_network",ip: "192.168.13.20#{settings[:nid] + 1}" , bridge: [  "wlp0s20f3" ]
      node.vm.network :forwarded_port, guest: 22, host: 3200 + settings[:nid] ,  id: "ssh"
      node.vm.provider :virtualbox do |v|
        v.memory = settings[:memory]
        v.cpus = settings[:cpus]
      end
      node.vm.provision "shell", path: "provision.sh", env: {
        "K8S_MINOR" => "v1.35"
      }
    end
  end
end
